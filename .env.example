# API base URL - use /api when using Vite proxy (dev), or full HTTPS URL for production
# IMPORTANT: Production must use HTTPS to avoid mixed-content blocking (HTTPS page cannot call HTTP API)
VITE_API_BASE_URL=/api

# Optional: privacy/contact email shown on /privacy-policy and /terms-of-service (defaults if unset)
# VITE_LEGAL_CONTACT_EMAIL=privacy@yourcompany.com
