# Copy to tests/.env.test.local (gitignored)
#
# LOCAL (recommended for local MongoDB):
#   node scripts/provision-local-automation.mjs --write-env
#   TEST_ENV=local, phone 9900099000, password LocalE2e!2026
#
# PREPROD:
#   node scripts/provision-automation-owner.mjs --write-env
#   See docs/AUTOMATION_DEDICATED_ACCOUNT.md
TEST_ENV=staging
TEST_ALLOW_MUTATIONS=1

TEST_OWNER_PHONE=9900099000
TEST_OWNER_PASSWORD=AutomationE2e!2026

# Local overrides (when TEST_ENV=local):
# TEST_API_BASE_URL=http://localhost:3000/api
# PLAYWRIGHT_BASE_URL=http://localhost:5199
# VITE_API_BASE_URL=http://localhost:3000/api

# Optional — external dashboard (Playwright otherwise starts Vite on :5199)
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# PLAYWRIGHT_SKIP_WEBSERVER=1
# VITE_API_BASE_URL=https://preprod-engine.neuoptic.in/api

# Optional — override API (used for docs; dashboard build bakes VITE_API_BASE_URL)
# TEST_API_BASE_URL=https://preprod-engine.neuoptic.in/api
